# --- Secrets: never commit real configuration / credentials ---
# The real per-host state (contains the Galaxy password) is generated by
# Ansible on the target host. Only state.json.example is committed.
app/state.json
*.pem
*.key
*.crt
*.crl
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# --- Virtual environments ---
# The deployment creates a fresh venv on the target host via Ansible.
# The local `vendor/` dir is a dev convenience and must not be committed.
venv/
.env/
.venv/
vendor/

# --- Logs / runtime ---
*.log
logs/
*.pid
*.sock

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
