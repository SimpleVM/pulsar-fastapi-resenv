# --- Secrets: never commit real configuration / credentials ---
# The real per-host credentials live in the BYOC files the Pulsar BYOC play
# writes onto the cluster master (/opt/pulsar/byoc-*.yml). They are generated
# at provisioning time and are never part of this repository.
app/state.json
*.pem
*.key
*.crt
*.crl
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# --- Virtual environments ---
# The deployment creates a fresh venv on the target host via Ansible.
# The local `vendor/` dir is a dev convenience and must not be committed.
venv/
.env/
.venv/
vendor/

# --- Logs / runtime ---
*.log
logs/
*.pid
*.sock

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/
